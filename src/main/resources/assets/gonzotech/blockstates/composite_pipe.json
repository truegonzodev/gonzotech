{
  "multipart": [
    {
      "when": {
        "has_wire": "true",
        "axis": "z"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_wire"
      }
    },
    {
      "when": {
        "has_wire": "true",
        "axis": "x"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_wire",
        "y": 90
      }
    },
    {
      "when": {
        "has_wire": "true",
        "axis": "y"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_wire",
        "x": 90
      }
    },
    {
      "when": {
        "has_heat_pipe": "true",
        "axis": "z"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_heat_pipe"
      }
    },
    {
      "when": {
        "has_heat_pipe": "true",
        "axis": "x"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_heat_pipe",
        "y": 90
      }
    },
    {
      "when": {
        "has_heat_pipe": "true",
        "axis": "y"
      },
      "apply": {
        "model": "gonzotech:block/composite_part_heat_pipe",
        "x": 90
      }
    }
  ]
}
